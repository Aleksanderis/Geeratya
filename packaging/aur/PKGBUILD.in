pkgver=@PKGVER@
pkgrel=1
pkgdesc='Keyboard-first terminal client for Jira Cloud'
arch=('x86_64' 'aarch64')
url='https://github.com/Aleksanderis/Geeratya'
license=('MIT')
depends=('openssl' 'zlib')
provides=('geeratya')
conflicts=('geeratya')
source_x86_64=("geeratya-@VERSION@-linux-x64.tar.gz::https://github.com/Aleksanderis/Geeratya/releases/download/v@VERSION@/geeratya-@VERSION@-linux-x64.tar.gz")
source_aarch64=("geeratya-@VERSION@-linux-arm64.tar.gz::https://github.com/Aleksanderis/Geeratya/releases/download/v@VERSION@/geeratya-@VERSION@-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA_LINUX@')
sha256sums_aarch64=('@SHA_LINUX_ARM@')

package() {
  local dir=geeratya-@VERSION@-linux-x64
